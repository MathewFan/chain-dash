{
  "name": "chain-dash",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration.ts",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "24.9.0",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
